{
  "id": "ai.model.openai",
  "name": "OpenAI Model",
  "version": 2,
  "nodeVersion": "1.0.0",
  "author": "Fuse Official",
  "category": "AI_CHAT_MODEL",
  "service": "openai",
  "connectionType": "auxiliary",
  "description": "Configure OpenAI models (GPT-4, GPT-3.5) for AI Agents.",
  "tags": [
    "ai",
    "llm",
    "openai",
    "gpt-4"
  ],
  "icon": "Sparkles",
  "runtime": {
    "type": "internal",
    "language": "python",
    "minPythonVersion": "3.9"
  },
  "inputs": [
    {
      "name": "credential",
      "type": "credential",
      "label": "OpenAI Credential",
      "credential_type": "ai_provider",
      "required": true
    },
    {
      "name": "model",
      "type": "select",
      "label": "Model",
      "required": true,
      "options": [
        {
          "label": "GPT-4o",
          "value": "openai/gpt-4o"
        },
        {
          "label": "GPT-4o Mini",
          "value": "openai/gpt-4o-mini"
        },
        {
          "label": "GPT-4 Turbo",
          "value": "openai/gpt-4-turbo"
        }
      ]
    },
    {
      "name": "temperature",
      "type": "number",
      "label": "Temperature",
      "default": 0.7,
      "min": 0,
      "max": 2
    }
  ],
  "outputs": [
    {
      "name": "model",
      "type": "AI_MODEL",
      "label": "Model Connector",
      "description": "Connect this to an AI Agent's Chat Model input"
    }
  ]
}